# Models of selected vehicle manufacturers: type, country, dimensions, timeline
# Модели выбранных производителей транспорта: тип, страна, размеры, временная ось
SELECT DISTINCT
  ?model ?modelLabel
  ?type ?typeLabel
  ?manufacturer ?manufacturerLabel
  ?countryLabel
  ?startProduction
  ?predecessorLabel
  ?successorLabel
  ?length ?width ?height ?mass
  ?image
WHERE {
  VALUES (?manufacturer ?country) {
    (wd:Q29637 wd:Q213)      # Škoda Auto — Czech Republic
    (wd:Q246 wd:Q183)        # Volkswagen — Germany
    (wd:Q26678 wd:Q183)       # BMW — Germany
    (wd:Q27530 wd:Q183)     # Mercedes-Benz Group — Germany
    (wd:Q98584518 wd:Q142)      # Renault — France
    (wd:Q44294 wd:Q30)       # Ford Motor Company — USA (если захотите, можно убрать)
    (wd:Q2309 wd:Q159)      # AvtoVAZ — Russia
    (wd:Q28616 wd:Q159)      # GAZ — Russia
    (wd:Q30378 wd:Q159)      # KamAZ — Russia
  }
  ?model wdt:P176 ?manufacturer .          # производитель модели
  ?model wdt:P31 ?type .                   # тип объекта: car model / bus model / truck model ...
  OPTIONAL { ?model wdt:P580 ?startProduction . }  # начало производства
  OPTIONAL { ?model wdt:P155 ?predecessor . }      # предшественник
  OPTIONAL { ?model wdt:P156 ?successor . }        # преемник
  OPTIONAL { ?model wdt:P2043 ?length . }          # длина
  OPTIONAL { ?model wdt:P2049 ?width . }           # ширина
  OPTIONAL { ?model wdt:P2048 ?height . }          # высота
  OPTIONAL { ?model wdt:P2067 ?mass . }            # масса
  OPTIONAL { ?model wdt:P18 ?image . }             # изображение
  
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,mul". }
}
ORDER BY ?countryLabel ?manufacturerLabel ?typeLabel ?startProduction ?modelLabel
