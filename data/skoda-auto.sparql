SELECT DISTINCT ?model ?modelLabel ?startProduction ?predecessorLabel ?successorLabel ?height ?width ?length ?mass ?website ?image 
WHERE {
  ?model wdt:P176 wd:Q29637 .

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
  
  OPTIONAL { ?model wdt:P580 ?startProduction . }
  OPTIONAL { ?model wdt:P155 ?predecessor . }
  OPTIONAL { ?model wdt:P156 ?successor . }
  OPTIONAL { ?model wdt:P2048 ?height . }
  OPTIONAL { ?model wdt:P2049 ?width . }
  OPTIONAL { ?model wdt:P2043 ?length . }
  OPTIONAL { ?model wdt:P2067 ?mass . }
  OPTIONAL { ?model wdt:P856 ?website . }
  OPTIONAL { ?model wdt:P18 ?image . }
}
ORDER BY ASC(?startProduction) ?modelLabel
